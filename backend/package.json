{
  "name": "backend",
  "version": "1.0.0",
  "description": "Day-Balance REST API backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "create-test-user": "tsx src/scripts/create-test-user.ts",
    "test:neon": "tsx src/scripts/test-neon-services.ts",
    "test:stats": "tsx src/scripts/test-stats-endpoint.ts",
    "test:first-time": "tsx src/scripts/test-first-time-flow.ts",
    "test:timer-math": "tsx --test src/tests/timer-math.test.ts",
    "test:core-flow": "tsx src/scripts/test-core-flow.ts",
    "test": "tsx --test src/tests/timer-math.test.ts && tsx src/scripts/test-login-flow.ts && tsx src/scripts/test-stats-endpoint.ts && tsx src/scripts/test-first-time-flow.ts && tsx src/scripts/test-core-flow.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@neondatabase/serverless": "^1.2.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
